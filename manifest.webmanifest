{
  "name": "Smart Business Manager — Finance & Inventory",
  "short_name": "Smart Business",
  "description": "Offline-first business, finance and inventory manager for small businesses. Excel alternative with charts, invoices, reports and low-stock alerts. Arabic, French and English.",
  "id": "/smart-business-manager/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#020617",
  "dir": "auto",
  "lang": "ar",
  "categories": ["business", "finance", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New transaction",
      "short_name": "New entry",
      "url": "./index.html#/transactions",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Inventory",
      "short_name": "Stock",
      "url": "./index.html#/inventory",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "url": "./index.html#/reports",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ]
}
